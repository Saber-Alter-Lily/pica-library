<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- This opted-in local APK cannot connect to manga providers, WebDAV or Desktop. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:node="remove" />
    <application android:usesCleartextTraffic="false">
        <!-- Keep the original explicit first-use disclaimer/consent gate.
             It goes to the existing HomeActivity, now in local-only mode. -->
        <activity android:name=".PairingActivity" tools:node="remove" />
    </application>
</manifest>
