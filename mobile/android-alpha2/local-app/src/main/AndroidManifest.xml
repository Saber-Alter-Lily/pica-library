<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No INTERNET, provider account, package install, camera or broad storage permission. SAF is user-selected. -->
    <!-- The source-free Reader cannot make network requests. An optional,
         same-signer companion may provide owned images through Binder only. -->
    <!-- Permission ownership belongs to the Reader, NOT the optional Host.
         This prevents a separately installed source from defining Reader trust. -->
    <permission android:name="com.picalibrary.android.remote.BIND_SOURCE"
        android:protectionLevel="signature"/>
    <uses-permission android:name="com.picalibrary.android.remote.BIND_SOURCE"/>
    <queries>
        <package android:name="com.picalibrary.android.userhost.qa"/>
    </queries>
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:label="Pica Library Local QA"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name="com.picalibrary.android.LocalHistoryActivity"
            android:exported="false" />
        <activity
            android:name="com.picalibrary.android.LocalShelvesActivity"
            android:exported="false" />
        <activity android:name="com.picalibrary.android.ExternalReaderActivity"
            android:exported="true"
            android:permission="com.picalibrary.android.remote.BIND_SOURCE"/>
        <activity android:name="com.picalibrary.android.ExternalImportActivity"
            android:exported="true"
            android:permission="com.picalibrary.android.remote.BIND_SOURCE"/>
        <activity
            android:name="com.picalibrary.android.LocalReaderActivity"
            android:screenOrientation="unspecified"
            android:exported="false" />
        <activity
            android:name="com.picalibrary.android.LocalLibraryActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
