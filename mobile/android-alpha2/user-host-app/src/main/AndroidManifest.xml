<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Only user-authorized external Host transport requests INTERNET.
         No Reader, LocalComicStore, broad storage or source provider SDK. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <permission android:name="com.picalibrary.android.remote.BIND_SOURCE"
        android:protectionLevel="signature"/>
    <uses-permission android:name="com.picalibrary.android.remote.BIND_SOURCE"/>
    <queries><package android:name="com.picalibrary.android.localcore.qa"/></queries>
    <application android:allowBackup="false" android:usesCleartextTraffic="true"
        android:label="Pica Library Sources QA"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <service android:name="com.picalibrary.android.ExternalSourceService"
            android:exported="true"
            android:permission="com.picalibrary.android.remote.BIND_SOURCE">
            <intent-filter><action android:name="com.picalibrary.android.remote.BIND_SOURCE"/></intent-filter>
        </service>
        <!-- A user-visible config UI can be opened by the original Reader
             or Launcher. It grants no authority on launch; its IPC is signed. -->
        <activity android:name="com.picalibrary.android.HostBrowserActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
