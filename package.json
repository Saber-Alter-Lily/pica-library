{
  "name": "pica-library",
  "version": "0.3.0",
  "private": true,
  "author": "Saber-Alter-Lily",
  "contributors": [
    "Neo (justorez) - upstream pica-cli author"
  ],
  "description": "Collection-centric Pica library manager, explainable discovery engine and shared local/GitHub downloader",
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "bin": {
    "pica-library": "dist/pica-library.js"
  },
  "scripts": {
    "dev": "tsx src/library-cli.ts",
    "build": "rimraf dist && rollup --config rollup.config.js",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-package.ps1",
    "build:local-update": "tsx scripts/build-local-update-package.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "type:check": "tsc --incremental --noEmit",
    "lint": "eslint --no-cache --max-warnings=0 --ignore-path .gitignore .",
    "lint:fix": "eslint --no-cache --fix --ignore-path .gitignore .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "web:check": "node --check web/app.js && node --check web/author-state.js && node --check web/i18n.js && node --check web/lite-state.js",
    "benchmark": "tsx scripts/benchmark/download-harness.ts"
  },
  "engines": {
    "node": ">=22.5"
  },
  "homepage": "https://github.com/Saber-Alter-Lily/pica-library",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saber-Alter-Lily/pica-library.git"
  },
  "bugs": {
    "url": "https://github.com/Saber-Alter-Lily/pica-library/issues"
  },
  "keywords": [
    "pica",
    "comic-library",
    "downloader",
    "metadata",
    "recommendation"
  ],
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@inquirer/checkbox": "^1.5.2",
    "@inquirer/input": "^1.2.16",
    "@inquirer/password": "^2.0.0",
    "@inquirer/select": "^1.3.3",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@types/adm-zip": "^0.5.5",
    "@types/debug": "^4.1.12",
    "@types/node": "^24.0.0",
    "@types/progress": "^2.0.7",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "@vitest/ui": "^1.5.2",
    "adm-zip": "^0.5.10",
    "axios": "^1.6.7",
    "debug": "^4.3.4",
    "dotenv": "^16.4.1",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "figures": "^6.0.1",
    "mime": "^4.0.1",
    "ora": "^8.0.1",
    "p-limit": "^5.0.0",
    "picocolors": "^1.0.0",
    "prettier": "3.2.4",
    "progress": "^2.0.3",
    "rimraf": "^5.0.5",
    "rollup": "^4.9.6",
    "rollup-plugin-esbuild": "^6.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.5.2"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "supports-color": "^9.4.0"
  }
}
