# Account used only by connected local commands.
PICA_ACCOUNT=
# Password is read from the environment and never exported.
PICA_PASSWORD=
# Optional proxy, for example http://127.0.0.1:7890
PICA_PROXY=
# Shared picture concurrency.
PICA_DL_CONCURRENCY=5
# Optional library directory template.
PICA_LIBRARY_PATH_TEMPLATE={author}/{title} [{short_id}]/{chapter_order} - {chapter}
